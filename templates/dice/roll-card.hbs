<div class="swia-roll-card">
  <header class="roll-card-header">
    <span class="roll-card-title">{{title}}</span>
    {{#if subtitle}}<span class="roll-card-subtitle">{{subtitle}}</span>{{/if}}
    {{#if targetName}}<span class="roll-card-target">{{localize "SWIA.Roll.Target"}}: {{targetName}}</span>{{/if}}
  </header>

  {{#if attackFaces.length}}
  <div class="roll-card-faces">
    {{#each attackFaces}}
    <div class="swia-die-reroll-wrapper">
      <img class="swia-card-die {{color}}{{#if rerolled}} rerolled{{/if}}" src="{{img}}" title="{{label}}" alt="{{label}}" />
      {{#if ../canReroll}}
      <button type="button" class="die-reroll-btn" data-swia-reroll-side="attack" data-swia-reroll-index="{{@index}}" title="{{localize 'SWIA.Combat.Reroll'}}">&#8634;</button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{#if defenseFaces.length}}
  <div class="roll-card-faces defense">
    {{#each defenseFaces}}
    <div class="swia-die-reroll-wrapper">
      <img class="swia-card-die {{color}}{{#if rerolled}} rerolled{{/if}}" src="{{img}}" title="{{label}}" alt="{{label}}" />
      {{#if ../canReroll}}
      <button type="button" class="die-reroll-btn" data-swia-reroll-side="defense" data-swia-reroll-index="{{@index}}" title="{{localize 'SWIA.Combat.Reroll'}}">&#8634;</button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if hasConditionNotes}}
  <p class="roll-card-keyword roll-card-conditions">
    {{localize "SWIA.Conditions.Title"}}: {{#each conditionNotes}}<span class="roll-condition-note">{{{this}}}</span>{{/each}}
  </p>
  {{/if}}

  {{#if isTest}}
  <div class="roll-card-result">
    <span class="roll-card-net" title="{{localize 'SWIA.Roll.TestSurges'}}">{{localize "SWIA.Roll.TestSurges"}}: {{{swiaGlyph "surge"}}} {{usableSurge}}</span>
  </div>
  {{else}}
  <div class="roll-card-totals">
    {{#if isAttack}}
    <span class="total damage" title="{{localize 'SWIA.Dice.Damage'}}">{{{swiaGlyph "damage"}}} {{totalDamage}}</span>
    <span class="total surge" title="{{localize 'SWIA.Roll.SurgesAvailable'}}">{{{swiaGlyph "surge"}}} {{usableSurge}}</span>
    <span class="total accuracy" title="{{localize 'SWIA.Roll.TotalAccuracy'}}">{{{swiaGlyph "accuracy"}}} {{totalAccuracy}}</span>
    {{/if}}
    {{#if showDefenseTotals}}
    <span class="total block" title="{{localize 'SWIA.Dice.Block'}}{{#if armorBlock}} ({{localize 'SWIA.Roll.FromArmor' count=armorBlock}}){{/if}}">{{{swiaGlyph "block"}}} {{#if pierceTotal}}{{effectiveBlock}} ({{block}}{{#if bonusBlock}}+{{bonusBlock}}{{/if}}&minus;{{pierceTotal}}){{else}}{{effectiveBlock}}{{#if bonusBlock}} ({{block}}+{{bonusBlock}}){{/if}}{{/if}}</span>
    {{#if totalEvade}}<span class="total evade" title="{{localize 'SWIA.Dice.Evade'}}{{#if armorEvade}} ({{localize 'SWIA.Roll.FromArmor' count=armorEvade}}){{/if}}">{{{swiaGlyph "evade"}}} {{totalEvade}}{{#if bonusEvade}} ({{evade}}+{{bonusEvade}}){{/if}}</span>{{/if}}
    {{#if dodged}}<span class="total dodge" title="{{localize 'SWIA.Dice.Dodge'}}">{{{swiaGlyph "dodge"}}} {{localize "SWIA.Dice.Dodge"}}!</span>{{/if}}
    {{/if}}
  </div>

  {{#if hasDeclaredTokens}}
  <p class="roll-card-keyword roll-card-declared-tokens">
    {{localize "SWIA.Combat.DeclaredTokens"}}:
    {{#if tokenDamage}}+{{tokenDamage}} {{{swiaGlyph "damage"}}}{{/if}}
    {{#if tokenSurge}} +{{tokenSurge}} {{{swiaGlyph "surge"}}}{{/if}}
    {{#if tokenBlock}} +{{tokenBlock}} {{{swiaGlyph "block"}}}{{/if}}
    {{#if tokenEvade}} +{{tokenEvade}} {{{swiaGlyph "evade"}}}{{/if}}
  </p>
  {{/if}}
  {{#if isAttack}}
  <div class="roll-card-result {{#if dodged}}dodged{{/if}}">
    {{#if dodged}}
    <span class="roll-card-net">{{localize "SWIA.Roll.Dodged"}}</span>
    {{else}}
    <span class="roll-card-net">{{localize "SWIA.Roll.NetDamage"}}: {{netDamage}}</span>
    {{/if}}
  </div>
  {{#if blast}}
  <p class="roll-card-keyword">{{localize "SWIA.Keywords.Blast"}} {{blast}} &mdash; {{localize "SWIA.Roll.BlastHint"}}</p>
  {{/if}}
  {{#if cleave}}
  <p class="roll-card-keyword">{{localize "SWIA.Keywords.Cleave"}} &mdash; {{localize "SWIA.Roll.CleaveHint"}}</p>
  {{/if}}
  {{/if}}
  {{/if}}

  {{#if surgeAbilities.length}}
  <div class="roll-card-surges">
    <span class="roll-card-surges-title">{{localize "SWIA.Roll.SurgeAbilities"}}</span>
    {{#each surgeAbilities}}
    {{#if spent}}
    <button type="button" class="roll-card-surge-btn spent" data-swia-unspend-index="{{@index}}"
      title="{{localize 'SWIA.Combat.UnspendHint'}}" {{#if ../readOnly}}disabled{{/if}}>
      <span class="surge-cost">{{cost}}&times;</span>
      <span class="surge-label">{{{label}}}</span>
      {{#if exhaustToUse}}<span class="surge-exhaust-flag" title="{{localize 'SWIA.Combat.ExhaustsSource'}}">&#9889;</span>{{/if}}
      {{#if ../readOnly}}<i class="fas fa-check"></i>{{else}}<i class="fas fa-undo"></i>{{/if}}
    </button>
    {{else}}
    <button type="button" class="roll-card-surge-btn" data-swia-surge-index="{{@index}}" {{#unless affordable}}disabled{{/unless}}>
      <span class="surge-cost">{{cost}}&times;</span>
      <span class="surge-label">{{{label}}}</span>
      {{#if exhaustToUse}}<span class="surge-exhaust-flag" title="{{localize 'SWIA.Combat.ExhaustsSource'}}">&#9889;</span>{{/if}}
    </button>
    {{/if}}
    {{/each}}
  </div>
  {{/if}}
</div>
