<div class="swia-roll-dialog-body">
  <header class="roll-dialog-header">
    <span class="roll-actor-name">{{actorName}}</span>
    {{#if attributeLabel}}<span class="roll-attribute-label">{{attributeLabel}}</span>{{/if}}
    {{#if targetName}}
    <span class="roll-target">{{localize "SWIA.Roll.Target"}}: {{targetName}}</span>
    {{/if}}
  </header>

  {{#if showConditions}}
  <p class="roll-conditions" title="{{localize 'SWIA.Conditions.RollHint'}}">
    <i class="fas fa-notes-medical"></i> {{localize "SWIA.Conditions.Title"}}:
    {{#each conditionNotes}}<span class="roll-condition-note">{{{this}}}</span>{{/each}}
  </p>
  {{/if}}

  {{#if showWeaponSelect}}
  <div class="roll-weapon-row">
    <label>{{localize "SWIA.Roll.Weapon"}}</label>
    <select class="roll-weapon-select">
      {{#each weapons}}
      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#unless (eq cardState "ready")}} ({{cardState}}){{/unless}}</option>
      {{/each}}
    </select>
  </div>
  {{#if weaponAccuracy}}
  <p class="roll-weapon-meta">{{localize "SWIA.Item.Weapon.Accuracy"}}: {{weaponAccuracy}}</p>
  {{/if}}
  {{/if}}

  {{#if showAttack}}
  <fieldset class="roll-pool">
    <legend>{{localize "SWIA.Roll.AttackPool"}}</legend>
    <div class="roll-pool-grid">
      {{#each attackRows}}
      <div class="roll-pool-row">
        <span class="dice-block {{color}}" title="{{label}}"></span>
        <button type="button" class="pool-adjust" data-action="adjustDie" data-color="{{color}}" data-delta="-1">&minus;</button>
        <span class="pool-count">{{count}}</span>
        <button type="button" class="pool-adjust" data-action="adjustDie" data-color="{{color}}" data-delta="1">+</button>
      </div>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  {{#if showDefense}}
  <fieldset class="roll-pool">
    <legend>{{localize "SWIA.Roll.DefensePool"}}</legend>
    <div class="roll-pool-grid">
      {{#each defenseRows}}
      <div class="roll-pool-row">
        <span class="dice-block {{color}}" title="{{label}}"></span>
        <button type="button" class="pool-adjust" data-action="adjustDie" data-color="{{color}}" data-delta="-1">&minus;</button>
        <span class="pool-count">{{count}}</span>
        <button type="button" class="pool-adjust" data-action="adjustDie" data-color="{{color}}" data-delta="1">+</button>
      </div>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  {{#if showTokens}}
  <fieldset class="roll-pool roll-tokens">
    <legend>{{localize "SWIA.Roll.DeclareTokens"}}</legend>
    <p class="roll-tokens-hint">{{localize "SWIA.Roll.DeclareTokensHint"}}</p>
    <div class="roll-pool-grid">
      {{#each tokenRows}}
      <div class="roll-pool-row roll-token-row {{#if declared}}has-declared{{/if}}">
        <span class="pool-label" title="{{label}}">{{{swiaGlyph stat}}}<span class="pool-label-text">{{label}}</span></span>
        {{#if typedHeld}}
        <span class="roll-token-stepper" title="{{localize 'SWIA.Roll.TypedTokensHeld' label=label count=typedHeld}}">
          <button type="button" class="pool-adjust" data-action="adjustToken" data-stat="{{stat}}" data-kind="typed" data-delta="-1" {{#unless typed}}disabled{{/unless}}>&minus;</button>
          <span class="pool-count {{#if typed}}has-bonus{{/if}}">{{typed}}<small>/{{typedHeld}}</small></span>
          <button type="button" class="pool-adjust" data-action="adjustToken" data-stat="{{stat}}" data-kind="typed" data-delta="1" {{#unless canAddTyped}}disabled{{/unless}}>+</button>
        </span>
        {{/if}}
        {{#if anyHeld}}
        <span class="roll-token-stepper any" title="{{localize 'SWIA.Roll.AnyTokensAs' label=label}}">
          <img class="roll-token-icon" src="{{anyIcon}}" alt="" />
          <button type="button" class="pool-adjust" data-action="adjustToken" data-stat="{{stat}}" data-kind="any" data-delta="-1" {{#unless any}}disabled{{/unless}}>&minus;</button>
          <span class="pool-count {{#if any}}has-bonus{{/if}}">{{any}}</span>
          <button type="button" class="pool-adjust" data-action="adjustToken" data-stat="{{stat}}" data-kind="any" data-delta="1" {{#unless canAddAny}}disabled{{/unless}}>+</button>
        </span>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#if anyHeld}}<p class="roll-tokens-hint">{{localize "SWIA.Roll.AnyTokensHeld" count=anyHeld}}</p>{{/if}}
  </fieldset>
  {{/if}}

  {{#if showCards}}
  <fieldset class="roll-pool roll-card-uses">
    <legend>{{localize "SWIA.CardUse.Title"}}</legend>
    <p class="roll-tokens-hint">{{localize "SWIA.CardUse.DialogHint"}}</p>
    <div class="combat-card-uses">
      {{#each cardRows}}
      <div class="card-use-row {{#if declared}}applied{{/if}}">
        <button type="button" class="card-use-btn" data-action="toggleCardUse" data-key="{{key}}"
          title="{{#if reasonLabel}}{{reasonLabel}}{{else}}{{#if declared}}{{localize 'SWIA.CardUse.UndeclareHint'}}{{else}}{{localize 'SWIA.CardUse.DeclareHint'}}{{/if}}{{/if}}" {{#unless canToggle}}disabled{{/unless}}>
          {{#if isFriendly}}<span class="card-use-owner" title="{{localize 'SWIA.CardUse.FriendlyHint'}}">{{ownerName}}</span>{{/if}}<span class="card-use-name">{{name}}</span>
          {{#if effectHTML}}<span class="card-use-effect">{{{effectHTML}}}</span>{{/if}}
          {{#each costLabels}}<span class="card-use-cost">{{this}}</span>{{/each}}
          {{#if note}}<span class="card-use-note">{{note}}</span>{{/if}}
        </button>
      </div>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  <footer class="roll-dialog-actions">
    <button type="button" class="roll-execute-btn" data-action="executeRoll">
      <i class="fas fa-dice"></i> {{localize "SWIA.Roll.RollButton"}}
    </button>
  </footer>
</div>
