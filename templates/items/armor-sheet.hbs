<form class="swia-sheet item-sheet card-sheet weapon-sheet armor-sheet {{#if editMode}}editing{{/if}}" autocomplete="off">
  <div class="item-sheet-toolbar">
    {{#if isGM}}
    <button type="button" class="item-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit">
      {{#if editMode}}{{localize "SWIA.Item.ViewMode"}}{{else}}{{localize "SWIA.EditMode"}}{{/if}}
    </button>
    {{#if editMode}}
    <button type="button" class="item-save-btn" data-action="saveItem">
      {{localize "SWIA.Item.Save"}}
    </button>
    {{/if}}
    {{/if}}
  </div>

  <div class="weapon-card-frame">
    <header class="weapon-title-strip">
      {{#if editMode}}
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SWIA.Item.Name'}}" />
      {{else}}
      <h1>{{item.name}}</h1>
      {{/if}}
      <button type="button" class="card-state-pill {{systemData.cardState}}" data-action="cycleCardState" title="{{cardStateLabel}}">
        {{cardStateLabel}}
      </button>
      {{#if systemData.cost}}
      <span class="cost-chip" title="{{localize 'SWIA.Item.Weapon.Cost'}}">{{systemData.cost}} {{localize "SWIA.Item.Weapon.Credits"}}</span>
      {{/if}}
      {{#if systemData.heroClass}}
      <span class="cost-chip class-deck-chip" title="{{localize 'SWIA.Item.ClassDeck.Legend'}}">{{systemData.heroClass}} · {{#if systemData.classXp}}{{systemData.classXp}} {{localize "SWIA.Item.ClassCard.XP"}}{{else}}{{localize "SWIA.Inventory.ClassDeckStarter"}}{{/if}}</span>
      {{/if}}
    </header>

    <div class="weapon-art-area">
      <div class="weapon-art-panel">
        {{#if hasCardImage}}
        <img class="card-image {{systemData.cardState}}" src="{{item.img}}" {{#if editMode}}data-edit="img" data-action="editImage"{{/if}} title="{{item.name}}" alt="{{item.name}}" style="object-position: {{systemData.imageOffsetX}}% {{systemData.imageOffsetY}}%; transform: scale({{systemData.imageZoom}}); transform-origin: {{systemData.imageOffsetX}}% {{systemData.imageOffsetY}}%" />
        {{/if}}
        {{#unless hasCardImage}}
        <div class="card-placeholder" {{#if editMode}}data-edit="img" data-action="editImage"{{/if}}>
          <i class="fas fa-image"></i>
          <p>{{localize "SWIA.Item.ClickToUploadCard"}}</p>
        </div>
        {{/unless}}
      </div>

      <aside class="attack-badge armor-effects-badge" aria-label="{{localize 'SWIA.Item.Armor.Effects'}}">
        <div class="attack-badge-title">{{localize "SWIA.Item.Armor.Effects"}}</div>
        <div class="attack-badge-dice armor-effects-row">
          {{#each armorChips}}<span class="armor-fx-chip {{this.key}}">{{this.label}}{{#if (eq this.key "health")}} <img src="systems/swia/icons/Damage.png" alt="" />{{/if}}{{#if (eq this.key "block")}} <img src="systems/swia/icons/Block.png" alt="" />{{/if}}{{#if (eq this.key "evade")}} <img src="systems/swia/icons/Evade.png" alt="" />{{/if}}</span>{{/each}}
          {{#unless hasArmorEffects}}<span class="armor-fx-chip none">{{localize "SWIA.Item.Armor.NoEffects"}}</span>{{/unless}}
        </div>
      </aside>
    </div>

    <div class="weapon-subtitle-row">
      {{#if editMode}}
      <input class="weapon-traits-input" name="system.traits" type="text" value="{{systemData.traits}}" placeholder="{{localize 'SWIA.Item.Armor.TraitsPlaceholder'}}" />
      <label class="keyword-toggle equipped-toggle {{#if systemData.equipped}}is-on{{/if}}" title="{{localize 'SWIA.Item.Armor.EquippedHint'}}">
        <input name="system.equipped" type="checkbox" {{#if systemData.equipped}}checked{{/if}} />
        <span>{{localize "SWIA.Item.Armor.Equipped"}}</span>
      </label>
      {{else}}
      {{#if systemData.traits}}<p class="weapon-traits-text">{{systemData.traits}}</p>{{/if}}
      {{#if armorClassLabel}}<p class="weapon-type-line">{{armorClassLabel}}</p>{{/if}}
      <span class="equipped-pill {{#if systemData.equipped}}is-on{{/if}}" title="{{localize 'SWIA.Item.Armor.EquippedHint'}}">
        {{#if systemData.equipped}}{{localize "SWIA.Item.Armor.Equipped"}}{{else}}{{localize "SWIA.Item.Armor.NotEquipped"}}{{/if}}
      </span>
      {{/if}}
    </div>

    {{#if editMode}}
    <div class="weapon-meta-edit">
      <div class="meta-edit-row">
        <div class="edit-field armor-effects-edit">
          <label title="{{localize 'SWIA.Item.Armor.EffectsHint'}}">{{localize "SWIA.Item.Armor.Effects"}}</label>
          {{> "systems/swia/templates/items/parts/modifier-editor.hbs" path="system.modifier" mod=systemData.modifier}}
        </div>
        <div class="edit-field numeric-trio">
          <div class="numeric-field">
            <label>{{localize "SWIA.Item.Weapon.Cost"}}</label>
            <input name="system.cost" type="number" value="{{systemData.cost}}" data-dtype="Number" min="0" />
          </div>
        </div>
        <div class="edit-field class-deck-edit-field">
          <label>{{localize "SWIA.Item.ClassDeck.Legend"}}</label>
          <div class="class-deck-edit-grid">
            <label title="{{localize 'SWIA.Item.ClassDeck.HeroClassHint'}}">{{localize "SWIA.Item.ClassDeck.HeroClass"}}
              <input name="system.heroClass" type="text" value="{{systemData.heroClass}}" placeholder="{{localize 'SWIA.Item.ClassCard.HeroClassPlaceholder'}}" />
            </label>
            <label title="{{localize 'SWIA.Item.ClassDeck.XpHint'}}">{{localize "SWIA.Item.ClassDeck.Xp"}}
              <input name="system.classXp" type="number" value="{{systemData.classXp}}" data-dtype="Number" min="0" max="4" />
            </label>
          </div>
        </div>
        <div class="edit-field">
          <label>{{localize "SWIA.Item.Armor.ArmorClassLabel"}}</label>
          <select name="system.armorClass" data-dtype="String">
            <option value="" {{#unless systemData.armorClass}}selected{{/unless}}>{{localize "SWIA.Item.Armor.ArmorClass.None"}}</option>
            <option value="light" {{#if (eq systemData.armorClass "light")}}selected{{/if}}>{{localize "SWIA.Item.Armor.ArmorClass.Light"}}</option>
            <option value="medium" {{#if (eq systemData.armorClass "medium")}}selected{{/if}}>{{localize "SWIA.Item.Armor.ArmorClass.Medium"}}</option>
            <option value="heavy" {{#if (eq systemData.armorClass "heavy")}}selected{{/if}}>{{localize "SWIA.Item.Armor.ArmorClass.Heavy"}}</option>
          </select>
        </div>
      </div>
      {{#if hasCardImage}}
      <details class="image-framing">
        <summary>{{localize "SWIA.Item.Weapon.ImageFraming"}}</summary>
        <div class="meta-edit-row image-position-row">
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImagePositionX"}}</label>
            <input name="system.imageOffsetX" type="range" value="{{systemData.imageOffsetX}}" data-dtype="Number" min="0" max="100" step="1" />
          </div>
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImagePositionY"}}</label>
            <input name="system.imageOffsetY" type="range" value="{{systemData.imageOffsetY}}" data-dtype="Number" min="0" max="100" step="1" />
          </div>
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImageZoom"}}</label>
            <input name="system.imageZoom" type="range" value="{{systemData.imageZoom}}" data-dtype="Number" min="0.25" max="3" step="0.05" />
          </div>
        </div>
      </details>
      {{/if}}
    </div>
    {{/if}}

    <section class="weapon-abilities-section">
      {{#if editMode}}
      <div class="section-header">
        <h3>{{localize "SWIA.Item.Weapon.Abilities"}}</h3>
        <button type="button" data-action="addAbility">{{localize "SWIA.Item.Weapon.AddAbility"}}</button>
      </div>
      {{/if}}

      <ol class="weapon-abilities-list">
        {{#each enrichedAbilities as |ability index|}}
        <li class="weapon-ability-row">
          {{#if ../editMode}}
          <input class="ability-desc-input" type="text" value="{{ability.description}}" placeholder="{{localize 'SWIA.Item.Armor.AbilityPlaceholder'}}" />
          <button type="button" class="ability-delete" data-action="removeAbility" data-index="{{index}}" title="{{localize 'SWIA.Item.Weapon.RemoveAbility'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{else}}
          <span class="weapon-ability-view">
            <span class="ability-rich-text">{{{ability.enrichedDescription}}}</span>
          </span>
          {{/if}}
        </li>
        {{else}}
        <li class="empty-message">{{localize "SWIA.Item.Weapon.NoAbilities"}}</li>
        {{/each}}
      </ol>
    </section>

    <section class="weapon-flavor-section">
      {{#if editMode}}
      <h3>{{localize "SWIA.Item.Weapon.FlavorText"}}</h3>
      <textarea name="system.description" data-dtype="String" rows="4" placeholder="{{localize 'SWIA.Item.Weapon.FlavorPlaceholder'}}">{{systemData.description}}</textarea>
      {{else}}
      <div class="flavor-display">{{{enrichedDescription}}}</div>
      {{/if}}
    </section>
  </div>
</form>
