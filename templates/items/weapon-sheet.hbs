<form class="swia-sheet item-sheet card-sheet weapon-sheet {{#if editMode}}editing{{/if}}" autocomplete="off">
  <div class="item-sheet-toolbar">
    {{#if isGM}}
    <button type="button" class="item-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit">
      {{#if editMode}}{{localize "SWIA.Item.ViewMode"}}{{else}}{{localize "SWIA.EditMode"}}{{/if}}
    </button>
    {{#if editMode}}
    <button type="button" class="item-save-btn" data-action="saveItem">
      {{localize "SWIA.Item.Save"}}
    </button>
    {{/if}}
    {{/if}}
  </div>

  <div class="weapon-card-frame">
    <header class="weapon-title-strip">
      {{#if editMode}}
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SWIA.Item.Name'}}" />
      {{else}}
      <h1>{{item.name}}</h1>
      {{/if}}
      <button type="button" class="card-state-pill {{systemData.cardState}}" data-action="cycleCardState" title="{{cardStateLabel}}">
        {{cardStateLabel}}
      </button>
      {{#if systemData.cost}}
      <span class="cost-chip" title="{{localize 'SWIA.Item.Weapon.Cost'}}">{{systemData.cost}} {{localize "SWIA.Item.Weapon.Credits"}}</span>
      {{/if}}
      {{#if systemData.heroClass}}
      <span class="cost-chip class-deck-chip" title="{{localize 'SWIA.Item.ClassDeck.Legend'}}">{{systemData.heroClass}} · {{#if systemData.classXp}}{{systemData.classXp}} {{localize "SWIA.Item.ClassCard.XP"}}{{else}}{{localize "SWIA.Inventory.ClassDeckStarter"}}{{/if}}</span>
      {{/if}}
    </header>

    <div class="weapon-art-area">
      <div class="weapon-art-panel">
        {{#if hasCardImage}}
        <img class="card-image {{systemData.cardState}}" src="{{item.img}}" {{#if editMode}}data-edit="img" data-action="editImage"{{/if}} title="{{item.name}}" alt="{{item.name}}" style="object-position: {{systemData.imageOffsetX}}% {{systemData.imageOffsetY}}%; transform: scale({{systemData.imageZoom}}); transform-origin: {{systemData.imageOffsetX}}% {{systemData.imageOffsetY}}%" />
        {{/if}}
        {{#unless hasCardImage}}
        <div class="card-placeholder" {{#if editMode}}data-edit="img" data-action="editImage"{{/if}}>
          <i class="fas fa-image"></i>
          <p>{{localize "SWIA.Item.ClickToUploadCard"}}</p>
        </div>
        {{/unless}}
      </div>

      <aside class="attack-badge" aria-label="{{localize 'SWIA.Attributes.Attack'}}">
        <div class="attack-badge-title">{{localize "SWIA.Attributes.Attack"}}</div>
        <div class="attack-badge-icon">
          {{#if (eq systemData.range "melee")}}
          <img src="systems/swia/icons/Melee.png" alt="{{localize 'SWIA.Item.Weapon.RangeMelee'}}" />
          {{else}}
          <img src="systems/swia/icons/Ranged.png" alt="{{localize 'SWIA.Item.Weapon.RangeRanged'}}" />
          {{/if}}
        </div>
        <div class="attack-badge-dice">
          {{#if systemData.poolAttribute}}
          <span class="attack-pip variable" title="{{localize 'SWIA.Item.Weapon.PoolAttributeVariable'}}">?</span>
          <span class="attack-pip variable" title="{{localize 'SWIA.Item.Weapon.PoolAttributeVariable'}}">?</span>
          <span class="attack-pip variable" title="{{localize 'SWIA.Item.Weapon.PoolAttributeVariable'}}">?</span>
          {{else}}
          {{#each (range systemData.attackDice.red)}}<span class="attack-pip red" title="{{localize 'SWIA.Attack.Red'}}"></span>{{/each}}
          {{#each (range systemData.attackDice.blue)}}<span class="attack-pip blue" title="{{localize 'SWIA.Attack.Blue'}}"></span>{{/each}}
          {{#each (range systemData.attackDice.green)}}<span class="attack-pip green" title="{{localize 'SWIA.Attack.Green'}}"></span>{{/each}}
          {{#each (range systemData.attackDice.yellow)}}<span class="attack-pip yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span>{{/each}}
          {{/if}}
        </div>
        {{#if systemData.accuracy}}
        <div class="attack-badge-accuracy" title="{{localize 'SWIA.Item.Weapon.Accuracy'}}">
          <span class="accuracy-value">{{systemData.accuracy}}</span>
          <span class="accuracy-label">{{localize "SWIA.Item.Weapon.Accuracy"}}</span>
        </div>
        {{/if}}
      </aside>

    </div>

    <div class="weapon-subtitle-row">
      {{#if editMode}}
      <input class="weapon-traits-input" name="system.traits" type="text" value="{{systemData.traits}}" placeholder="{{localize 'SWIA.Item.Weapon.TraitsPlaceholder'}}" />
      <div class="weapon-range-pill">
        <label>{{localize "SWIA.Item.Weapon.Range"}}</label>
        <select name="system.range" data-dtype="String">
          <option value="melee" {{#if (eq systemData.range "melee")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.RangeMelee"}}</option>
          <option value="ranged" {{#if (eq systemData.range "ranged")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.RangeRanged"}}</option>
        </select>
      </div>
      {{else}}
      {{#if systemData.traits}}<p class="weapon-traits-text">{{systemData.traits}}</p>{{/if}}
      {{#if systemData.weaponClass}}
      <p class="weapon-type-line">{{systemData.weaponClass}}{{#if systemData.weaponSubtype}} - {{systemData.weaponSubtype}}{{/if}}</p>
      {{/if}}
      {{#if keywordsLine}}<p class="weapon-keywords-line">{{keywordsLine}}</p>{{/if}}
      {{/if}}
    </div>

    {{#if editMode}}
    <div class="weapon-meta-edit">
      <div class="meta-edit-row">
        <div class="edit-field">
          <label>{{localize "SWIA.Item.Weapon.WeaponClass"}}</label>
          <select name="system.weaponClass" data-dtype="String">
            <option value="">{{localize "SWIA.Item.Weapon.WeaponClassPlaceholder"}}</option>
            <option value="Blaster" {{#if (eq systemData.weaponClass "Blaster")}}selected{{/if}}>Blaster</option>
            <option value="Disrupter" {{#if (eq systemData.weaponClass "Disrupter")}}selected{{/if}}>Disrupter</option>
            <option value="Blade" {{#if (eq systemData.weaponClass "Blade")}}selected{{/if}}>Blade</option>
            <option value="Fist" {{#if (eq systemData.weaponClass "Fist")}}selected{{/if}}>Fist</option>
            <option value="Staff" {{#if (eq systemData.weaponClass "Staff")}}selected{{/if}}>Staff</option>
          </select>
        </div>
        <div class="edit-field">
          <label>{{localize "SWIA.Item.Weapon.WeaponSubtype"}}</label>
          <select name="system.weaponSubtype" data-dtype="String">
            <option value="">{{localize "SWIA.Item.Weapon.WeaponSubtypePlaceholder"}}</option>
            {{#if (eq systemData.weaponClass "Blaster")}}
            <option value="Pistol" {{#if (eq systemData.weaponSubtype "Pistol")}}selected{{/if}}>Pistol</option>
            <option value="Rifle" {{#if (eq systemData.weaponSubtype "Rifle")}}selected{{/if}}>Rifle</option>
            <option value="Heavy" {{#if (eq systemData.weaponSubtype "Heavy")}}selected{{/if}}>Heavy</option>
            {{/if}}
            {{#if (eq systemData.weaponClass "Disrupter")}}
            <option value="Rifle" {{#if (eq systemData.weaponSubtype "Rifle")}}selected{{/if}}>Rifle</option>
            {{/if}}
            {{#if (eq systemData.weaponClass "Blade")}}
            <option value="Energy" {{#if (eq systemData.weaponSubtype "Energy")}}selected{{/if}}>Energy</option>
            <option value="Fist" {{#if (eq systemData.weaponSubtype "Fist")}}selected{{/if}}>Fist</option>
            <option value="Staff" {{#if (eq systemData.weaponSubtype "Staff")}}selected{{/if}}>Staff</option>
            {{/if}}
            {{#if (eq systemData.weaponClass "Staff")}}
            <option value="Energy" {{#if (eq systemData.weaponSubtype "Energy")}}selected{{/if}}>Energy</option>
            <option value="Rifle" {{#if (eq systemData.weaponSubtype "Rifle")}}selected{{/if}}>Rifle</option>
            {{/if}}
            {{#if (eq systemData.weaponClass "Fist")}}
            <option value="Blade" {{#if (eq systemData.weaponSubtype "Blade")}}selected{{/if}}>Blade</option>
            {{/if}}
          </select>
        </div>
      </div>
      <div class="meta-edit-row">
        <div class="edit-field dice-edit-field">
          <label>{{localize "SWIA.Item.Weapon.AttackDice"}}</label>
          <div class="dice-edit-grid dice-edit-row">
            <span class="dice-block red" title="{{localize 'SWIA.Attack.Red'}}"></span><input name="system.attackDice.red" type="number" value="{{systemData.attackDice.red}}" data-dtype="Number" min="0" />
            <span class="dice-block blue" title="{{localize 'SWIA.Attack.Blue'}}"></span><input name="system.attackDice.blue" type="number" value="{{systemData.attackDice.blue}}" data-dtype="Number" min="0" />
            <span class="dice-block green" title="{{localize 'SWIA.Attack.Green'}}"></span><input name="system.attackDice.green" type="number" value="{{systemData.attackDice.green}}" data-dtype="Number" min="0" />
            <span class="dice-block yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span><input name="system.attackDice.yellow" type="number" value="{{systemData.attackDice.yellow}}" data-dtype="Number" min="0" />
          </div>
        </div>
        <div class="edit-field">
          <label>{{localize "SWIA.Item.Weapon.PoolAttribute"}}</label>
          <select name="system.poolAttribute" data-dtype="String">
            <option value="" {{#unless systemData.poolAttribute}}selected{{/unless}}>{{localize "SWIA.Item.Weapon.PoolAttributeNone"}}</option>
            <option value="strength" {{#if (eq systemData.poolAttribute "strength")}}selected{{/if}}>{{localize "SWIA.Attributes.Strength"}}</option>
            <option value="insight" {{#if (eq systemData.poolAttribute "insight")}}selected{{/if}}>{{localize "SWIA.Attributes.Insight"}}</option>
            <option value="tech" {{#if (eq systemData.poolAttribute "tech")}}selected{{/if}}>{{localize "SWIA.Attributes.Tech"}}</option>
          </select>
        </div>
      </div>
      <div class="meta-edit-row">
        <div class="edit-field numeric-trio">
          <div class="numeric-field">
            <label>{{localize "SWIA.Item.Weapon.AttachmentSlots"}}</label>
            <input name="system.attachmentSlots" type="number" value="{{systemData.attachmentSlots}}" data-dtype="Number" min="0" max="5" />
          </div>
          <div class="numeric-field">
            <label>{{localize "SWIA.Item.Weapon.Accuracy"}}</label>
            <input name="system.accuracy" type="number" value="{{systemData.accuracy}}" data-dtype="Number" min="0" />
          </div>
          <div class="numeric-field">
            <label>{{localize "SWIA.Item.Weapon.Cost"}}</label>
            <input name="system.cost" type="number" value="{{systemData.cost}}" data-dtype="Number" min="0" />
          </div>
        </div>
        <div class="edit-field class-deck-edit-field">
          <label>{{localize "SWIA.Item.ClassDeck.Legend"}}</label>
          <div class="class-deck-edit-grid">
            <label title="{{localize 'SWIA.Item.ClassDeck.HeroClassHint'}}">{{localize "SWIA.Item.ClassDeck.HeroClass"}}
              <input name="system.heroClass" type="text" value="{{systemData.heroClass}}" placeholder="{{localize 'SWIA.Item.ClassCard.HeroClassPlaceholder'}}" />
            </label>
            <label title="{{localize 'SWIA.Item.ClassDeck.XpHint'}}">{{localize "SWIA.Item.ClassDeck.Xp"}}
              <input name="system.classXp" type="number" value="{{systemData.classXp}}" data-dtype="Number" min="0" max="4" />
            </label>
          </div>
        </div>
        <div class="edit-field keywords-edit-field">
          <label>{{localize "SWIA.Item.Weapon.Keywords"}}</label>
          <div class="keywords-edit-grid">
            <label>{{localize "SWIA.Keywords.Pierce"}} <input name="system.keywords.pierce" type="number" value="{{systemData.keywords.pierce}}" data-dtype="Number" min="0" /></label>
            <label>{{localize "SWIA.Keywords.Blast"}} <input name="system.keywords.blast" type="number" value="{{systemData.keywords.blast}}" data-dtype="Number" min="0" /></label>
            <label class="keyword-toggle {{#if systemData.keywords.cleave}}is-on{{/if}}">
              <input name="system.keywords.cleave" type="checkbox" {{#if systemData.keywords.cleave}}checked{{/if}} />
              <span>{{localize "SWIA.Keywords.Cleave"}}</span>
            </label>
            <label class="keyword-toggle {{#if systemData.keywords.reach}}is-on{{/if}}">
              <input name="system.keywords.reach" type="checkbox" {{#if systemData.keywords.reach}}checked{{/if}} />
              <span>{{localize "SWIA.Keywords.Reach"}}</span>
            </label>
          </div>
        </div>
      </div>
      {{#if hasCardImage}}
      <details class="image-framing">
        <summary>{{localize "SWIA.Item.Weapon.ImageFraming"}}</summary>
        <div class="meta-edit-row image-position-row">
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImagePositionX"}}</label>
            <input name="system.imageOffsetX" type="range" value="{{systemData.imageOffsetX}}" data-dtype="Number" min="0" max="100" step="1" />
          </div>
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImagePositionY"}}</label>
            <input name="system.imageOffsetY" type="range" value="{{systemData.imageOffsetY}}" data-dtype="Number" min="0" max="100" step="1" />
          </div>
          <div class="edit-field image-position-field">
            <label>{{localize "SWIA.Item.Weapon.ImageZoom"}}</label>
            <input name="system.imageZoom" type="range" value="{{systemData.imageZoom}}" data-dtype="Number" min="0.25" max="3" step="0.05" />
          </div>
        </div>
      </details>
      {{/if}}
    </div>
    {{/if}}

    <section class="weapon-abilities-section">
      {{#if editMode}}
      <div class="section-header">
        <h3>{{localize "SWIA.Item.Weapon.Abilities"}}</h3>
        <button type="button" data-action="addAbility">{{localize "SWIA.Item.Weapon.AddAbility"}}</button>
      </div>
      {{/if}}

      <ol class="weapon-abilities-list">
        {{#each enrichedAbilities as |ability index|}}
        <li class="weapon-ability-row">
          {{#if ../editMode}}
          <input class="ability-desc-input" type="text" value="{{ability.description}}" placeholder="{{localize 'SWIA.Item.Weapon.AbilityPlaceholder'}}" />
          <button type="button" class="ability-delete" data-action="removeAbility" data-index="{{index}}" title="{{localize 'SWIA.Item.Weapon.RemoveAbility'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{else}}
          <span class="weapon-ability-view">
            <span class="ability-rich-text">{{{ability.enrichedDescription}}}</span>
          </span>
          {{/if}}
        </li>
        {{else}}
        <li class="empty-message">{{localize "SWIA.Item.Weapon.NoAbilities"}}</li>
        {{/each}}
      </ol>
    </section>

    <section class="weapon-abilities-section weapon-exhaust-section">
      {{#if editMode}}
      <div class="section-header">
        <h3>{{localize "SWIA.Item.Weapon.ExhaustAbilities"}}</h3>
        <button type="button" data-action="addExhaustAbility">{{localize "SWIA.Item.Weapon.AddExhaustAbility"}}</button>
      </div>
      {{else}}{{#if exhaustRows.length}}
      <div class="section-header"><h3>{{localize "SWIA.Item.Weapon.ExhaustAbilities"}}</h3></div>
      {{/if}}{{/if}}
      {{#if (or editMode exhaustRows.length)}}
      <ol class="weapon-abilities-list weapon-exhaust-list">
        {{#each exhaustRows as |row index|}}
        <li class="weapon-ability-row weapon-exhaust-row" data-index="{{index}}">
          {{#if ../editMode}}
          <select class="exhaust-trigger-input" data-dtype="String" title="{{localize 'SWIA.Item.Weapon.ExhaustTriggerLabel'}}">
            <option value="action" {{#if (eq row.trigger "action")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.ExhaustTrigger.Action"}}</option>
            <option value="reaction" {{#if (eq row.trigger "reaction")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.ExhaustTrigger.Reaction"}}</option>
            <option value="free" {{#if (eq row.trigger "free")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.ExhaustTrigger.Free"}}</option>
          </select>
          <input class="ability-desc-input exhaust-effect-input" type="text" value="{{row.effect}}" placeholder="{{localize 'SWIA.Item.Weapon.ExhaustEffectPlaceholder'}}" />
          <button type="button" class="ability-delete" data-action="removeExhaustAbility" data-index="{{index}}" title="{{localize 'SWIA.Item.Weapon.RemoveExhaustAbility'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{else}}
          <span class="weapon-ability-view">
            <span class="exhaust-trigger-tag">{{row.triggerLabel}}</span>
            <span class="ability-rich-text">{{row.effect}}</span>
          </span>
          {{/if}}
        </li>
        {{else}}
        <li class="empty-message">{{localize "SWIA.Item.Weapon.NoExhaustAbilities"}}</li>
        {{/each}}
      </ol>
      {{/if}}
    </section>

    <section class="weapon-surge-section">
      {{#if editMode}}
      <div class="section-header">
        <h3>{{localize "SWIA.Item.Weapon.SurgeAbilities"}}</h3>
        <button type="button" data-action="addSurgeAbility">{{localize "SWIA.Item.Weapon.AddSurge"}}</button>
      </div>
      <ol class="weapon-surge-list edit-list">
        {{#each weaponSurgeRows as |surge index|}}
        <li class="weapon-surge-entry" data-index="{{index}}">
          <label class="surge-field surge-cost-field">
            <span>{{localize "SWIA.Item.Weapon.SurgeCost"}}</span>
            <input class="weapon-surge-cost" type="number" min="1" value="{{surge.cost}}" />
          </label>
          <label class="surge-field surge-type-field">
            <span>{{localize "SWIA.Item.Weapon.SurgeEffectTypeLabel"}}</span>
            <select class="weapon-surge-type">
              <option value="damage" {{#if (eq surge.effectType "damage")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.SurgeEffectType.Damage"}}</option>
              <option value="accuracy" {{#if (eq surge.effectType "accuracy")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.SurgeEffectType.Accuracy"}}</option>
              <option value="pierce" {{#if (eq surge.effectType "pierce")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.SurgeEffectType.Pierce"}}</option>
              <option value="condition" {{#if (eq surge.effectType "condition")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.SurgeEffectType.Condition"}}</option>
              <option value="special" {{#if (eq surge.effectType "special")}}selected{{/if}}>{{localize "SWIA.Item.Weapon.SurgeEffectType.Special"}}</option>
            </select>
          </label>
          <label class="surge-field surge-value-field">
            <span>{{localize "SWIA.Item.Weapon.SurgeEffectValue"}}</span>
            <input class="weapon-surge-value" type="number" min="0" value="{{surge.effectValue}}" />
          </label>
          <input class="weapon-surge-text" type="text" value="{{surge.effectText}}" placeholder="{{localize 'SWIA.Item.Weapon.SurgeEffectPlaceholder'}}" />
          <label class="surge-field surge-exhaust-field" title="{{localize 'SWIA.Item.Weapon.ExhaustToUseHint'}}">
            <input class="weapon-surge-exhaust" type="checkbox" {{#if surge.exhaustToUse}}checked{{/if}} />
            <span>{{localize "SWIA.Item.Weapon.ExhaustToUse"}}</span>
          </label>
          <button type="button" class="remove-row-btn" data-action="removeSurgeAbility" data-index="{{index}}" title="{{localize 'SWIA.Item.Weapon.RemoveSurge'}}">
            <i class="fas fa-trash"></i>
          </button>
        </li>
        {{else}}
        <li class="empty-message">{{localize "SWIA.Item.Weapon.NoSurgeAbilities"}}</li>
        {{/each}}
      </ol>
      {{else}}
      {{#if weaponSurgeRows.length}}
      <ol class="weapon-surge-list view-list">
        {{#each weaponSurgeRows}}
        <li class="weapon-surge-entry-view">
          <span class="surge-cost-label" title="{{localize 'SWIA.Item.Weapon.SurgeCost'}}">{{this.cost}}&times; {{localize "SWIA.Surge"}}</span>
          <span class="surge-effect">{{this.displayEffect}}</span>
          {{#if this.exhaustToUse}}<span class="surge-exhaust-tag" title="{{localize 'SWIA.Item.Weapon.ExhaustToUseHint'}}">&#9889; {{localize "SWIA.Item.Weapon.ExhaustToUse"}}</span>{{/if}}
        </li>
        {{/each}}
      </ol>
      {{/if}}
      {{/if}}
    </section>

    <section class="weapon-flavor-section">
      {{#if editMode}}
      <h3>{{localize "SWIA.Item.Weapon.FlavorText"}}</h3>
      {{/if}}
      {{#if editMode}}
      <textarea name="system.description" data-dtype="String" rows="4" placeholder="{{localize 'SWIA.Item.Weapon.FlavorPlaceholder'}}">{{systemData.description}}</textarea>
      {{else}}
      <div class="flavor-display">{{{enrichedDescription}}}</div>
      {{/if}}
    </section>

    <footer class="weapon-bottom-row">
      {{#unless editMode}}
      {{#if systemData.attachmentSlots}}
      <div class="attachment-pips" title="{{localize 'SWIA.Item.Weapon.AttachmentSlots'}}: {{systemData.attachmentSlots}}">
        {{#each (range systemData.attachmentSlots)}}
        <span class="attachment-pip"></span>
        {{/each}}
      </div>
      {{/if}}
      {{/unless}}
    </footer>
  </div>
</form>
