<form class="swia-sheet item-sheet card-sheet gear-sheet {{#if editMode}}editing{{/if}}" autocomplete="off">
  <div class="item-sheet-toolbar">
    {{#if isGM}}
    <button type="button" class="item-edit-toggle {{#if editMode}}active{{/if}}" data-action="toggleEdit">
      {{#if editMode}}{{localize "SWIA.Item.ViewMode"}}{{else}}{{localize "SWIA.EditMode"}}{{/if}}
    </button>
    {{#if editMode}}
    <button type="button" class="item-save-btn" data-action="saveItem">
      {{localize "SWIA.Item.Save"}}
    </button>
    {{/if}}
    {{/if}}
  </div>

  <div class="card-image-container">
    {{#if hasCardImage}}
    <img class="card-image {{systemData.cardState}}" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" alt="{{item.name}}" />
    {{/if}}
    {{#unless hasCardImage}}
    <div class="card-placeholder" data-edit="img" data-action="editImage">
      <i class="fas fa-image"></i>
      <p>{{localize "SWIA.Item.ClickToUploadCard"}}</p>
    </div>
    {{/unless}}
    <button type="button" class="card-state-btn {{systemData.cardState}}" data-action="cycleCardState" title="{{cardStateLabel}}">
      {{cardStateLabel}}
    </button>
  </div>

  <div class="item-sheet-body">
    <div class="item-name-row">
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SWIA.Item.Name'}}" {{#unless editMode}}disabled{{/unless}} />
    </div>

    {{#if editMode}}
    <div class="edit-field class-deck-edit-field">
      <label>{{localize "SWIA.Item.ClassDeck.Legend"}}</label>
      <div class="class-deck-edit-grid">
        <label title="{{localize 'SWIA.Item.ClassDeck.HeroClassHint'}}">{{localize "SWIA.Item.ClassDeck.HeroClass"}}
          <input name="system.heroClass" type="text" value="{{systemData.heroClass}}" placeholder="{{localize 'SWIA.Item.ClassCard.HeroClassPlaceholder'}}" />
        </label>
        <label title="{{localize 'SWIA.Item.ClassDeck.XpHint'}}">{{localize "SWIA.Item.ClassDeck.Xp"}}
          <input name="system.classXp" type="number" value="{{systemData.classXp}}" data-dtype="Number" min="0" max="4" />
        </label>
      </div>
    </div>
    {{else}}{{#if systemData.heroClass}}
    <div class="class-deck-line">
      <span class="cost-chip class-deck-chip" title="{{localize 'SWIA.Item.ClassDeck.Legend'}}">{{systemData.heroClass}} · {{#if systemData.classXp}}{{systemData.classXp}} {{localize "SWIA.Item.ClassCard.XP"}}{{else}}{{localize "SWIA.Inventory.ClassDeckStarter"}}{{/if}}</span>
    </div>
    {{/if}}{{/if}}

    <section class="item-description-section">
      <h3>{{localize "SWIA.Item.Description"}}</h3>
      <div class="editor-container">
        {{#if editMode}}
        <div class="html-editor">
          <label class="editor-label">{{localize "SWIA.Item.Description"}} (HTML)</label>
          <textarea name="system.description" data-dtype="String" rows="8">{{systemData.description}}</textarea>
          <div class="editor-hint">{{localize "SWIA.BiographyHint"}}</div>
        </div>
        {{else}}
        <div class="editor">
          <div class="editor-content">{{{ enrichedDescription }}}</div>
        </div>
        {{/if}}
      </div>
    </section>
  </div>
</form>
