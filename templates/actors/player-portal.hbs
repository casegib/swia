<section class="swia-player-portal">

  {{#if hasActors}}
    <div class="portal-grid">
      {{#each actors as |actor|}}
        <div class="portal-actor-section">
        <article class="portal-card type-{{actor.type}} {{#if actor.isMine}}is-mine{{/if}} {{#if actor.isWounded}}is-wounded{{/if}} {{#if actor.isDefeated}}is-defeated{{/if}}">
          <div class="identity">
            <img src="{{actor.tokenImage}}" alt="{{actor.name}}" loading="lazy">
            <div class="identity-text">
              <h3>
                <button
                  type="button"
                  class="actor-name-link"
                  data-action="openActor"
                  data-actor-id="{{actor.id}}"
                  title="{{localize 'SWIA.Portal.OpenSheet'}}"
                >
                  {{actor.name}}
                </button>
              </h3>
              <div class="activation-row {{#if actor.canManage}}is-clickable{{/if}}" title="{{actor.activationTokenLabel}}">
                <img
                  src="{{actor.activationTokenIcon}}"
                  alt="{{actor.activationTokenLabel}}"
                  class="activation-token"
                  loading="lazy"
                  data-action="toggleActivated"
                  data-actor-id="{{actor.id}}"
                >
              </div>
              <div class="type-row">
                <span>{{actor.typeLabel}}</span>
                {{#if actor.isHero}}
                <button
                  type="button"
                  class="portal-state-pill {{#if actor.isWounded}}pill-wounded{{else}}pill-healthy{{/if}}"
                  data-action="toggleWounded"
                  data-actor-id="{{actor.id}}"
                  title="{{#if actor.isWounded}}{{localize 'SWIA.State.WoundedHint'}}{{else}}{{localize 'SWIA.State.HealthyHint'}}{{/if}}"
                  {{#unless actor.canManage}}disabled{{/unless}}
                >
                  <i class="fas {{#if actor.isWounded}}fa-heart-crack{{else}}fa-heart{{/if}}"></i>
                  {{#if actor.isWounded}}{{localize "SWIA.State.Wounded"}}{{else}}{{localize "SWIA.State.Healthy"}}{{/if}}
                </button>
                {{#if actor.isWounded}}
                <button
                  type="button"
                  class="portal-state-pill {{#if actor.isDefeated}}pill-defeated{{else}}pill-active{{/if}}"
                  data-action="toggleDefeated"
                  data-actor-id="{{actor.id}}"
                  title="{{#if actor.isDefeated}}{{localize 'SWIA.State.DefeatedHint'}}{{else}}{{localize 'SWIA.State.ActiveHint'}}{{/if}}"
                  {{#unless actor.canManage}}disabled{{/unless}}
                >
                  <i class="fas {{#if actor.isDefeated}}fa-skull{{else}}fa-person-running{{/if}}"></i>
                  {{#if actor.isDefeated}}{{localize "SWIA.State.Defeated"}}{{else}}{{localize "SWIA.State.Active"}}{{/if}}
                </button>
                {{/if}}
                {{/if}}
              </div>
              {{#if actor.powerTokens.length}}
              <div class="power-token-tray" title="{{localize 'SWIA.PowerTokensTitle'}}">
                {{#each actor.powerTokens as |tok|}}
                <span class="power-token-chip {{#unless tok.count}}empty{{/unless}}" title="{{tok.label}}">
                  {{#if actor.canEditTokens}}<button type="button" class="power-token-step" data-action="adjustPowerToken" data-actor-id="{{actor.id}}" data-token="{{tok.type}}" data-delta="-1" {{#unless tok.count}}disabled{{/unless}}>&minus;</button>{{/if}}
                  <img src="{{tok.icon}}" alt="{{tok.label}}" /><span class="power-token-count">{{tok.count}}</span>
                  {{#if actor.canEditTokens}}<button type="button" class="power-token-step" data-action="adjustPowerToken" data-actor-id="{{actor.id}}" data-token="{{tok.type}}" data-delta="1">+</button>{{/if}}
                </span>
                {{/each}}
              </div>
              {{/if}}
              {{> "systems/swia/templates/actors/parts/condition-tray.hbs" actor}}
            </div>
            {{#if actor.isHero}}
            <div class="portal-xp" title="{{localize 'SWIA.Portal.UnspentXpHint'}}">
              <span class="xp-row">
                {{#if actor.canEditXp}}
                <button type="button" class="xp-step" data-action="adjustXp" data-actor-id="{{actor.id}}" data-delta="-1">&minus;</button>
                {{/if}}
                <span class="xp-value">{{actor.xp}}</span>
                {{#if actor.canEditXp}}
                <button type="button" class="xp-step" data-action="adjustXp" data-actor-id="{{actor.id}}" data-delta="1">+</button>
                {{/if}}
              </span>
              <span class="xp-label">{{localize "SWIA.Portal.UnspentXp"}}</span>
            </div>
            {{/if}}
          </div>

          <div class="stats-grid">
            <div class="stat-box">
              <label>{{localize "SWIA.Attributes.Health"}}</label>
              <div class="portal-stepper">
                <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{actor.id}}" data-stat="health" data-delta="-1" title="{{localize 'SWIA.Attributes.HealthMinus'}}" {{#unless actor.canManage}}disabled{{/unless}}>&minus;</button>
                <strong>{{actor.health.value}}</strong>
                <span class="stat-max" {{#if actor.health.equipmentBonus}}title="{{localize 'SWIA.Attributes.FromEquipment' base=actor.health.baseMax bonus=actor.health.equipmentBonus}}"{{/if}}>/{{actor.health.max}}{{#if actor.health.equipmentBonus}}<span class="armor-health-note">+{{actor.health.equipmentBonus}}</span>{{/if}}</span>
                <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{actor.id}}" data-stat="health" data-delta="1" title="{{localize 'SWIA.Attributes.HealthPlus'}}" {{#unless actor.canManage}}disabled{{/unless}}>+</button>
              </div>
            </div>

            {{#if actor.isHero}}
              <div class="stat-box">
                <label>{{localize "SWIA.Attributes.Endurance"}}</label>
                <div class="portal-stepper">
                  <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{actor.id}}" data-stat="endurance" data-delta="-1" title="{{localize 'SWIA.Attributes.EnduranceMinus'}}" {{#unless actor.canManage}}disabled{{/unless}}>&minus;</button>
                  <strong>{{actor.endurance.value}}</strong>
                  <span class="stat-max">/{{actor.endurance.max}}</span>
                  <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{actor.id}}" data-stat="endurance" data-delta="1" title="{{localize 'SWIA.Attributes.EndurancePlus'}}" {{#unless actor.canManage}}disabled{{/unless}}>+</button>
                </div>
              </div>
            {{/if}}

            <div class="stat-box">
              <label>{{localize "SWIA.Attributes.Speed"}}</label>
              <strong>{{actor.speed}}</strong>
            </div>
          </div>

          {{#if actor.isHero}}
            <section class="portal-hero-abilities">
              {{#if actor.enrichedHeroAbilities.length}}
                {{#each actor.enrichedHeroAbilities}}
                  {{#if this.name}}
                  <div class="hero-ability-view">
                    <strong class="hero-ability-name">{{this.name}}</strong>
                    <div class="editor"><div class="editor-content hero-ability-description">{{{this.enrichedDescription}}}</div></div>
                  </div>
                  {{/if}}
                {{/each}}
              {{else}}
                <p class="list-empty">{{localize "SWIA.Hero.NoHeroAbilities"}}</p>
              {{/if}}
            </section>
          {{/if}}

          {{#if actor.isHero}}
            <div class="dice-list hero-dice-row">
              <div class="dice-line hero-dice-line">
                <label>{{localize "SWIA.Attributes.Defense"}}</label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="defense" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.defenseBlackDice}}<span class="dice-block black" title="{{localize 'SWIA.Defense.Black'}}"></span>{{/each}}
                  {{#each actor.defenseWhiteDice}}<span class="dice-block white" title="{{localize 'SWIA.Defense.White'}}"></span>{{/each}}
                </span>
                {{#if actor.armorBlock}}<span class="armor-fx-chip block" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{actor.armorBlock}} {{localize "SWIA.Dice.Block"}}</span>{{/if}}
                {{#if actor.armorEvade}}<span class="armor-fx-chip evade" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{actor.armorEvade}} {{localize "SWIA.Dice.Evade"}}</span>{{/if}}
              </div>
              <div class="dice-line hero-dice-line">
                <label class="dice-attr-icon" title="{{localize 'SWIA.Attributes.Strength'}}">
                  <img src="systems/swia/icons/Might.png" alt="{{localize 'SWIA.Attributes.Strength'}}" loading="lazy">
                </label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="test" data-attribute="strength" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.strengthRedDice}}<span class="dice-block red" title="{{localize 'SWIA.Attack.Red'}}"></span>{{/each}}
                  {{#each actor.strengthBlueDice}}<span class="dice-block blue" title="{{localize 'SWIA.Attack.Blue'}}"></span>{{/each}}
                  {{#each actor.strengthGreenDice}}<span class="dice-block green" title="{{localize 'SWIA.Attack.Green'}}"></span>{{/each}}
                  {{#each actor.strengthYellowDice}}<span class="dice-block yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span>{{/each}}
                </span>
              </div>
              <div class="dice-line hero-dice-line">
                <label class="dice-attr-icon" title="{{localize 'SWIA.Attributes.Insight'}}">
                  <img src="systems/swia/icons/Insight.png" alt="{{localize 'SWIA.Attributes.Insight'}}" loading="lazy">
                </label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="test" data-attribute="insight" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.insightRedDice}}<span class="dice-block red" title="{{localize 'SWIA.Attack.Red'}}"></span>{{/each}}
                  {{#each actor.insightBlueDice}}<span class="dice-block blue" title="{{localize 'SWIA.Attack.Blue'}}"></span>{{/each}}
                  {{#each actor.insightGreenDice}}<span class="dice-block green" title="{{localize 'SWIA.Attack.Green'}}"></span>{{/each}}
                  {{#each actor.insightYellowDice}}<span class="dice-block yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span>{{/each}}
                </span>
              </div>
              <div class="dice-line hero-dice-line">
                <label class="dice-attr-icon" title="{{localize 'SWIA.Attributes.Tech'}}">
                  <img src="systems/swia/icons/Tech.png" alt="{{localize 'SWIA.Attributes.Tech'}}" loading="lazy">
                </label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="test" data-attribute="tech" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.techRedDice}}<span class="dice-block red" title="{{localize 'SWIA.Attack.Red'}}"></span>{{/each}}
                  {{#each actor.techBlueDice}}<span class="dice-block blue" title="{{localize 'SWIA.Attack.Blue'}}"></span>{{/each}}
                  {{#each actor.techGreenDice}}<span class="dice-block green" title="{{localize 'SWIA.Attack.Green'}}"></span>{{/each}}
                  {{#each actor.techYellowDice}}<span class="dice-block yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span>{{/each}}
                </span>
              </div>
            </div>
            <div class="portal-action-row">
              <button
                type="button"
                class="portal-attack-btn"
                data-action="rollDice"
                data-actor-id="{{actor.id}}"
                data-roll-type="attack"
                title="{{localize 'SWIA.Roll.ClickToRoll'}}"
              >
                <i class="fas fa-dice"></i> {{localize "SWIA.Roll.WeaponAttack"}}
              </button>
              {{#if actor.canManage}}
              <button
                type="button"
                class="portal-ready-all"
                data-action="readyAllItems"
                data-actor-id="{{actor.id}}"
                title="{{localize 'SWIA.Inventory.ReadyAllHint'}}"
                {{#unless actor.hasReadyableCards}}disabled{{/unless}}
              >
                <i class="fas fa-rotate-left"></i> {{localize "SWIA.Inventory.ReadyAll"}}
              </button>
              {{/if}}
            </div>
          {{else}}
            <div class="dice-list">
              <div class="dice-line">
                <label>{{localize "SWIA.Attributes.Defense"}}</label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="defense" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.defenseBlackDice}}<span class="dice-block black" title="{{localize 'SWIA.Defense.Black'}}"></span>{{/each}}
                  {{#each actor.defenseWhiteDice}}<span class="dice-block white" title="{{localize 'SWIA.Defense.White'}}"></span>{{/each}}
                </span>
                {{#if actor.armorBlock}}<span class="armor-fx-chip block" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{actor.armorBlock}} {{localize "SWIA.Dice.Block"}}</span>{{/if}}
                {{#if actor.armorEvade}}<span class="armor-fx-chip evade" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{actor.armorEvade}} {{localize "SWIA.Dice.Evade"}}</span>{{/if}}
              </div>
              <div class="dice-line">
                <label>{{localize "SWIA.Attributes.Attack"}}</label>
                <span class="dice-blocks rollable" data-action="rollDice" data-actor-id="{{actor.id}}" data-roll-type="attack" title="{{localize 'SWIA.Roll.ClickToRoll'}}">
                  {{#each actor.attackRedDice}}<span class="dice-block red" title="{{localize 'SWIA.Attack.Red'}}"></span>{{/each}}
                  {{#each actor.attackBlueDice}}<span class="dice-block blue" title="{{localize 'SWIA.Attack.Blue'}}"></span>{{/each}}
                  {{#each actor.attackGreenDice}}<span class="dice-block green" title="{{localize 'SWIA.Attack.Green'}}"></span>{{/each}}
                  {{#each actor.attackYellowDice}}<span class="dice-block yellow" title="{{localize 'SWIA.Attack.Yellow'}}"></span>{{/each}}
                </span>
              </div>
            </div>
            {{#if actor.canManage}}
            <div class="portal-action-row">
              <button type="button" class="portal-ready-all" data-action="readyAllItems" data-actor-id="{{actor.id}}" title="{{localize 'SWIA.Inventory.ReadyAllHint'}}" {{#unless actor.hasReadyableCards}}disabled{{/unless}}>
                <i class="fas fa-rotate-left"></i> {{localize "SWIA.Inventory.ReadyAll"}}
              </button>
            </div>
            {{/if}}
          {{/if}}
        </article>
        {{#if actor.companions.length}}
        <div class="portal-companions">
          {{#each actor.companions as |companion|}}
          <article class="portal-companion-card {{#if companion.isWounded}}is-wounded{{/if}}" data-actor-id="{{companion.id}}">
            <img class="companion-portrait" src="{{companion.tokenImage}}" alt="{{companion.name}}" loading="lazy">
            <div class="companion-id">
              <button type="button" class="actor-name-link companion-name" data-action="openActor" data-actor-id="{{companion.id}}" title="{{localize 'SWIA.Portal.OpenSheet'}}">
                {{companion.name}}
              </button>
              <span class="companion-tag">{{localize "SWIA.Portal.CompanionTag"}}</span>
            </div>
            <div class="companion-stats">
              <span class="companion-stat">
                <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{companion.id}}" data-stat="health" data-delta="-1" {{#unless companion.canManage}}disabled{{/unless}}>&minus;</button>
                <strong>{{companion.health.value}}</strong><span class="stat-max" {{#if companion.health.equipmentBonus}}title="{{localize 'SWIA.Attributes.FromEquipment' base=companion.health.baseMax bonus=companion.health.equipmentBonus}}"{{/if}}>/{{companion.health.max}}{{#if companion.health.equipmentBonus}}<span class="armor-health-note">+{{companion.health.equipmentBonus}}</span>{{/if}}</span>
                <button type="button" class="portal-step" data-action="adjustStat" data-actor-id="{{companion.id}}" data-stat="health" data-delta="1" {{#unless companion.canManage}}disabled{{/unless}}>+</button>
              </span>
              <span class="companion-stat companion-speed">{{localize "SWIA.Attributes.Speed"}} <strong>{{companion.speed}}</strong></span>
              {{#if companion.canManage}}
              <button type="button" class="portal-ready-all companion-ready-all" data-action="readyAllItems" data-actor-id="{{companion.id}}" title="{{localize 'SWIA.Inventory.ReadyAllHint'}}" {{#unless companion.hasReadyableCards}}disabled{{/unless}}>
                <i class="fas fa-rotate-left"></i>
              </button>
              {{/if}}
              <span class="companion-dice" title="{{localize 'SWIA.Attributes.Defense'}}">
                {{#each companion.defenseBlackDice}}<span class="dice-block black"></span>{{/each}}
                {{#each companion.defenseWhiteDice}}<span class="dice-block white"></span>{{/each}}
              </span>
              {{#if companion.armorBlock}}<span class="armor-fx-chip block" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{companion.armorBlock}} {{localize "SWIA.Dice.Block"}}</span>{{/if}}
              {{#if companion.armorEvade}}<span class="armor-fx-chip evade" title="{{localize 'SWIA.Portal.FromArmor'}}">+{{companion.armorEvade}} {{localize "SWIA.Dice.Evade"}}</span>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
        {{/if}}
        <section class="portal-inventory" aria-label="Inventory">
          <div class="portal-inventory-grid">
              <div class="portal-item-column">
                <header>
                  <h3>{{localize "SWIA.Inventory.Weapons"}}</h3>
                  <span>{{actor.weaponCount}}</span>
                </header>
                <div class="portal-drop-zone {{#if actor.canManage}}can-drop{{/if}}" data-actor-id="{{actor.id}}" data-item-type="weapon">
                  {{#if actor.weapons.length}}
                    <div class="portal-card-stack">
                      {{#each actor.weapons as |item|}}
                        <article class="portal-item-card state-{{item.state}}" data-item-id="{{item.id}}">
                          <button
                            type="button"
                            class="portal-item-open swia-card-preview-trigger"
                            data-action="openItem"
                            data-actor-id="{{actor.id}}"
                            data-item-id="{{item.id}}"
                            title="{{item.name}}"
                          >
                            <img src="{{item.img}}" alt="{{item.name}}" loading="lazy">
                          </button>
                          <div class="portal-item-footer">
                            <button
                              type="button"
                              class="portal-item-state state-{{item.state}}"
                              data-action="cycleItemState"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{item.stateLabel}}"
                              {{#unless actor.canManage}}disabled{{/unless}}
                            >
                              {{item.stateLabel}}
                            </button>
                            <button
                              type="button"
                              class="portal-item-chat"
                              data-action="postItemCard"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{localize 'SWIA.Inventory.SendToChat'}}"
                            >
                              <i class="fas fa-comment"></i>
                            </button>
                          </div>
                          {{#if item.mods.length}}
                          <div class="portal-mod-chips">
                            {{#each item.mods as |mod|}}
                            <span class="portal-mod-chip" title="{{mod.name}}">
                              <span class="mod-chip-name">{{mod.name}}</span>
                              {{#each mod.redDice}}<span class="dice-block red"></span>{{/each}}
                              {{#each mod.blueDice}}<span class="dice-block blue"></span>{{/each}}
                              {{#each mod.greenDice}}<span class="dice-block green"></span>{{/each}}
                              {{#each mod.yellowDice}}<span class="dice-block yellow"></span>{{/each}}
                            </span>
                            {{/each}}
                          </div>
                          {{/if}}
                        </article>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              </div>

              <div class="portal-item-column">
                <header>
                  <h3>{{localize "SWIA.Inventory.Armor"}}</h3>
                  <span>{{actor.armorCount}}</span>
                </header>
                <div class="portal-drop-zone {{#if actor.canManage}}can-drop{{/if}}" data-actor-id="{{actor.id}}" data-item-type="armor">
                  {{#if actor.armor.length}}
                    <div class="portal-card-stack">
                      {{#each actor.armor as |item|}}
                        <article class="portal-item-card state-{{item.state}} {{#unless item.equipped}}is-unequipped{{/unless}}" data-item-id="{{item.id}}">
                          <button
                            type="button"
                            class="portal-item-open swia-card-preview-trigger"
                            data-action="openItem"
                            data-actor-id="{{actor.id}}"
                            data-item-id="{{item.id}}"
                            title="{{item.name}}"
                          >
                            <img src="{{item.img}}" alt="{{item.name}}" loading="lazy">
                          </button>
                          <div class="portal-item-footer">
                            <button
                              type="button"
                              class="portal-armor-equip {{#unless item.equipped}}off{{/unless}}"
                              data-action="toggleEquipArmor"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{#if item.equipped}}{{localize 'SWIA.Inventory.UnequipHint'}}{{else}}{{localize 'SWIA.Inventory.EquipHint'}}{{/if}}"
                              {{#unless actor.canManage}}disabled{{/unless}}
                            >
                              <i class="fas fa-shield-halved"></i>
                            </button>
                            <button
                              type="button"
                              class="portal-item-state state-{{item.state}}"
                              data-action="cycleItemState"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{item.stateLabel}}"
                              {{#unless actor.canManage}}disabled{{/unless}}
                            >
                              {{item.stateLabel}}
                            </button>
                            <button
                              type="button"
                              class="portal-item-chat"
                              data-action="postItemCard"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{localize 'SWIA.Inventory.SendToChat'}}"
                            >
                              <i class="fas fa-comment"></i>
                            </button>
                          </div>
                          {{#if item.hasEffects}}
                          <div class="portal-mod-chips armor-fx-chips">
                            {{#each item.chips}}<span class="armor-fx-chip {{this.key}}">{{this.label}}</span>{{/each}}
                          </div>
                          {{/if}}
                        </article>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              </div>

              <div class="portal-item-column">
                <header>
                  <h3>{{localize "SWIA.Inventory.Abilities"}}</h3>
                  <span>{{actor.abilityCount}}</span>
                </header>
                <div class="portal-drop-zone {{#if actor.canManage}}can-drop{{/if}}" data-actor-id="{{actor.id}}" data-item-type="classcard">
                  {{#if actor.abilities.length}}
                    <div class="portal-card-stack">
                      {{#each actor.abilities as |item|}}
                        <article class="portal-item-card state-{{item.state}}" data-item-id="{{item.id}}">
                          <button
                            type="button"
                            class="portal-item-open swia-card-preview-trigger"
                            data-action="openItem"
                            data-actor-id="{{actor.id}}"
                            data-item-id="{{item.id}}"
                            title="{{item.name}}"
                          >
                            <img src="{{item.img}}" alt="{{item.name}}" loading="lazy">
                          </button>
                          <div class="portal-item-footer">
                            <button
                              type="button"
                              class="portal-item-state state-{{item.state}}"
                              data-action="cycleItemState"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{item.stateLabel}}"
                              {{#unless actor.canManage}}disabled{{/unless}}
                            >
                              {{item.stateLabel}}
                            </button>
                            <button
                              type="button"
                              class="portal-item-chat"
                              data-action="postItemCard"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{localize 'SWIA.Inventory.SendToChat'}}"
                            >
                              <i class="fas fa-comment"></i>
                            </button>
                          </div>
                        </article>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              </div>

              <div class="portal-item-column">
                <header>
                  <h3>{{localize "SWIA.Inventory.Items"}}</h3>
                  <span>{{actor.gearCount}}</span>
                </header>
                <div class="portal-drop-zone {{#if actor.canManage}}can-drop{{/if}}" data-actor-id="{{actor.id}}" data-item-type="gear">
                  {{#if actor.gear.length}}
                    <div class="portal-card-stack">
                      {{#each actor.gear as |item|}}
                        <article class="portal-item-card state-{{item.state}}" data-item-id="{{item.id}}">
                          <button
                            type="button"
                            class="portal-item-open swia-card-preview-trigger"
                            data-action="openItem"
                            data-actor-id="{{actor.id}}"
                            data-item-id="{{item.id}}"
                            title="{{item.name}}"
                          >
                            <img src="{{item.img}}" alt="{{item.name}}" loading="lazy">
                          </button>
                          <div class="portal-item-footer">
                            <button
                              type="button"
                              class="portal-item-state state-{{item.state}}"
                              data-action="cycleItemState"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{item.stateLabel}}"
                              {{#unless actor.canManage}}disabled{{/unless}}
                            >
                              {{item.stateLabel}}
                            </button>
                            <button
                              type="button"
                              class="portal-item-chat"
                              data-action="postItemCard"
                              data-actor-id="{{actor.id}}"
                              data-item-id="{{item.id}}"
                              title="{{localize 'SWIA.Inventory.SendToChat'}}"
                            >
                              <i class="fas fa-comment"></i>
                            </button>
                          </div>
                        </article>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              </div>
            </div>
          </section>
        </div>
      {{/each}}
    </div>
  {{else}}
    <p class="portal-empty">{{localize "SWIA.Portal.Empty"}}</p>
  {{/if}}
</section>
